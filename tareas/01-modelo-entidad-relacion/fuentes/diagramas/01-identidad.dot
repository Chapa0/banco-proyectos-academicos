digraph ER {
graph [rankdir=LR, bgcolor="white", pad="0.18", nodesep="0.30", ranksep="0.55", splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=12, overlap=false, newrank=true];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=12, fontcolor="#475569", color="#758494", penwidth=0.9, arrowsize=0.55, arrowhead=normal];
usuario [id="entity-usuario", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#12666B"><TR><TD COLSPAN="2" PORT="header" ALIGN="LEFT" BGCOLOR="#12666B" CELLPADDING="8"><FONT FACE="Arial" POINT-SIZE="15" COLOR="white"><B>Usuario</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#12666B">PK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">id</FONT></TD></TR></TABLE>>];
empresa [id="entity-empresa", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#12666B"><TR><TD COLSPAN="2" PORT="header" ALIGN="LEFT" BGCOLOR="#12666B" CELLPADDING="8"><FONT FACE="Arial" POINT-SIZE="15" COLOR="white"><B>Empresa</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#12666B">PK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">id</FONT></TD></TR></TABLE>>];
representacion_empresa [id="entity-representacion_empresa", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#12666B"><TR><TD COLSPAN="2" PORT="header" ALIGN="LEFT" BGCOLOR="#12666B" CELLPADDING="8"><FONT FACE="Arial" POINT-SIZE="15" COLOR="white"><B>RepresentacionEmpresa</B></FONT></TD></TR><TR><TD PORT="usuario_id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#12666B">PK,FK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">usuario_id</FONT></TD></TR><TR><TD PORT="empresa_id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#12666B">FK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">empresa_id</FONT></TD></TR></TABLE>>];
alumno [id="entity-alumno", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#12666B"><TR><TD COLSPAN="2" PORT="header" ALIGN="LEFT" BGCOLOR="#12666B" CELLPADDING="8"><FONT FACE="Arial" POINT-SIZE="15" COLOR="white"><B>Alumno</B></FONT></TD></TR><TR><TD PORT="usuario_id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#12666B">PK,FK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">usuario_id</FONT></TD></TR></TABLE>>];
profesor [id="entity-profesor", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#12666B"><TR><TD COLSPAN="2" PORT="header" ALIGN="LEFT" BGCOLOR="#12666B" CELLPADDING="8"><FONT FACE="Arial" POINT-SIZE="15" COLOR="white"><B>Profesor</B></FONT></TD></TR><TR><TD PORT="usuario_id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#12666B">PK,FK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">usuario_id</FONT></TD></TR></TABLE>>];
usuario:header:e -> alumno:usuario_id:w [id="relation-usuario-alumno-usuario_id", label="1 / 0..1",   weight=3];
usuario:header:e -> profesor:usuario_id:w [id="relation-usuario-profesor-usuario_id", label="1 / 0..1",   weight=3];
usuario:header:e -> representacion_empresa:usuario_id:w [id="relation-usuario-representacion_empresa-usuario_id", label="1 / 0..1",   weight=3];
empresa:header:e -> representacion_empresa:empresa_id:w [id="relation-empresa-representacion_empresa-empresa_id", label="1 / 1..N",   weight=3];
}
