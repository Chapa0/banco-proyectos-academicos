digraph ER {
graph [rankdir=LR, bgcolor="white", pad="0.18", nodesep="0.30", ranksep="0.55", splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=12, overlap=false, newrank=true];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=12, fontcolor="#475569", color="#758494", penwidth=0.9, arrowsize=0.55, arrowhead=normal];
usuario [id="entity-usuario", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#12666B"><TR><TD COLSPAN="2" PORT="header" ALIGN="LEFT" BGCOLOR="#12666B" CELLPADDING="8"><FONT FACE="Arial" POINT-SIZE="15" COLOR="white"><B>Usuario</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#12666B">PK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#EAF5F4"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">id</FONT></TD></TR></TABLE>>];
candidatura [id="entity-candidatura", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#6A4C93"><TR><TD COLSPAN="2" PORT="header" ALIGN="LEFT" BGCOLOR="#6A4C93" CELLPADDING="8"><FONT FACE="Arial" POINT-SIZE="15" COLOR="white"><B>Candidatura</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#F2EDF8"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#6A4C93">PK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#F2EDF8"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">id</FONT></TD></TR><TR><TD PORT="alumno_id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#6A4C93">FK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">alumno_id</FONT></TD></TR><TR><TD PORT="proyecto_id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#F2EDF8"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#6A4C93">FK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#F2EDF8"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">proyecto_id</FONT></TD></TR></TABLE>>];
evaluacion_candidato [id="entity-evaluacion_candidato", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#A36115"><TR><TD COLSPAN="2" PORT="header" ALIGN="LEFT" BGCOLOR="#A36115" CELLPADDING="8"><FONT FACE="Arial" POINT-SIZE="15" COLOR="white"><B>EvaluacionCandidato</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FCF4E7"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#A36115">PK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FCF4E7"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">id</FONT></TD></TR><TR><TD PORT="candidatura_id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#A36115">FK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">candidatura_id</FONT></TD></TR><TR><TD PORT="evaluador_usuario_id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FCF4E7"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#A36115">FK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FCF4E7"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">evaluador_usuario_id</FONT></TD></TR></TABLE>>];
