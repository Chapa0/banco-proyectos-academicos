detalle_evaluacion [id="entity-detalle_evaluacion", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#A36115"><TR><TD COLSPAN="2" PORT="header" ALIGN="LEFT" BGCOLOR="#A36115" CELLPADDING="8"><FONT FACE="Arial" POINT-SIZE="15" COLOR="white"><B>DetalleEvaluacion</B></FONT></TD></TR><TR><TD PORT="evaluacion_id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FCF4E7"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#A36115">PK,FK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FCF4E7"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">evaluacion_id</FONT></TD></TR><TR><TD PORT="criterio_id" ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#A36115">PK,FK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="4" BGCOLOR="#FFFFFF"><FONT FACE="Arial" POINT-SIZE="12" COLOR="#172838">criterio_id</FONT></TD></TR></TABLE>>];
candidatura:header:e -> evaluacion_candidato:candidatura_id:w [id="relation-candidatura-evaluacion_candidato-candidatura_id", label="1 / 0..N",   weight=3];
usuario:header:e -> evaluacion_candidato:evaluador_usuario_id:w [id="relation-usuario-evaluacion_candidato-evaluador_usuario_id", label="1 / 0..N",   weight=1];
evaluacion_candidato:header:e -> detalle_evaluacion:evaluacion_id:w [id="relation-evaluacion_candidato-detalle_evaluacion-evaluacion_id", label="1 / 0..N",   weight=3];
criterio_evaluacion:header:e -> detalle_evaluacion:criterio_id:w [id="relation-criterio_evaluacion-detalle_evaluacion-criterio_id", label="1 / 0..N",   weight=3];
